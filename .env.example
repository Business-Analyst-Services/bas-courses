# Clerk — https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon — https://console.neon.tech → project → Connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated emails that get full admin access (all courses, presenter view, enrolment admin)
ADMIN_EMAILS=gday@business-analyst.services

# Optional — Humanitix ticket sync (Account → Advanced → Public API key) and the cron guard
HUMANITIX_API_KEY=
CRON_SECRET=some-long-random-string
